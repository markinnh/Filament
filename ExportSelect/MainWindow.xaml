<Window x:Class="ExportSelect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExportSelect" xmlns:view="clr-namespace:ExportSelect.View"
        xmlns:vm="clr-namespace:ExportSelect.ViewModel"
        mc:Ignorable="d"
        Title="Context Exporter" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="_File">
                <MenuItem Header="_Generate Code" Command="{Binding GenerateCodeCommand}"/>
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
        </Menu>
        <TabControl Grid.Row="1">
            <TabItem Header="Select Colors">
                <Frame Source="View/SelectColorsPage.xaml"/>
                
            </TabItem>
            <TabItem Header="Select Vendors">
                <!--<local:SelectModelsPage/>-->
                <TextBlock Text="Select Vendors Page Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="50" TextWrapping="Wrap"/>
            </TabItem>
            <TabItem Header="Select Filament Types">
                <TextBlock Text="Select Filament Types Page Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="50" TextWrapping="Wrap"/>
            </TabItem>
        </TabControl>
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
