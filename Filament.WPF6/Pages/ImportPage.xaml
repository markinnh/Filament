<Page x:Class="Filament.WPF6.Pages.ImportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Filament.WPF6.Pages"
      xmlns:vm="clr-namespace:Filament.WPF6.ViewModels"
      xmlns:models="clr-namespace:DataDefinitions.Models;assembly=DataDefinitions"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Width="400" Height="300"
      Title="ImportPage" AllowDrop="True" Background="Ivory" Drop="Page_Drop" Name="Main">
    <Page.DataContext>
        <vm:ImportViewModel />
    </Page.DataContext>
    <Page.Resources>
        <DataTemplate x:Key="DisplayVendorDefn" DataType="models:VendorDefn">
            <StackPanel >
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="{Binding WebUrl}" FontStyle="Italic" FontSize="12" Visibility="{Binding UrlHasContent,Mode=OneWay,Converter={StaticResource VisibilityConverter}}"/>
                <Button Style="{StaticResource RoundedCommandButton}" Visibility="{Binding NotAlreadyInDatabase,Converter={StaticResource VisibilityConverter}}" Command="{Binding Path=DataContext.ImportObjectCommand,ElementName=Main}" CommandParameter="{Binding .}">
                    <Button.Content>
                        <Rectangle Width="16 " Height="16">
                            <Rectangle.Resources>
                                <SolidColorBrush x:Key="canvas" Opacity="0" />
                                <SolidColorBrush x:Key="light-blue" Color="#005dba" Opacity="1" />
                            </Rectangle.Resources>
                            <Rectangle.Fill>
                                <DrawingBrush Stretch="None">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <DrawingGroup x:Name="canvas">
                                                <GeometryDrawing Brush="{DynamicResource canvas}" Geometry="F1M16,16H0V0H16Z" />
                                            </DrawingGroup>
                                            <DrawingGroup x:Name="level_1">
                                                <GeometryDrawing Brush="{DynamicResource light-blue}" Geometry="F1M10.354,14.354l-.708-.708L12.293,11H5.5a4.5,4.5,0,0,1,0-9V3a3.5,3.5,0,0,0,0,7h6.793L9.646,7.354l.708-.708,3.5,3.5v.708Z" />
                                            </DrawingGroup>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Button.Content></Button>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="DisplayFilamentDefn" DataType="models:FilamentDefn">
            <StackPanel>
                <TextBlock Text="{Binding Material.ShortName}" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="{Binding Material.Name}" FontStyle="Italic" FontSize="10"/>
                <TextBlock Text="{Binding VendorName}" FontSize="10"/>
                <TextBlock FontSize="8">
                    <Run Text="Diameter: "/>
                    <Run Text="{Binding Diameter}"/>
                    <Run Text="mm"/>
                </TextBlock>
                <TextBlock FontSize="8"><Run Text="{Binding Density}"/><Run Text="gm/cc"/></TextBlock>
                <TextBlock Text="{Binding NotAlreadyInDatabase}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="DisplayFilamentColor" DataType="models:FilamentColor">
            <StackPanel Orientation="Horizontal" >
                <Border Background="{Binding ColorRGB}" Height="20" Width="20" Margin="0,0,5,0" CornerRadius="3"/>
                <TextBlock Text="{Binding VendorColorName}" FontWeight="Bold" FontSize="12"/>
                <Button Style="{StaticResource RoundedCommandButton}" Visibility="{Binding NotAlreadyInDatabase,Converter={StaticResource VisibilityConverter}}" Command="{Binding Path=DataContext.ImportObjectCommand,ElementName=Main}" CommandParameter="{Binding .}">
                    <Button.Content>
                        <Rectangle Width="16 " Height="16">
                            <Rectangle.Resources>
                                <SolidColorBrush x:Key="canvas" Opacity="0" />
                                <SolidColorBrush x:Key="light-blue" Color="#005dba" Opacity="1" />
                            </Rectangle.Resources>
                            <Rectangle.Fill>
                                <DrawingBrush Stretch="None">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <DrawingGroup x:Name="canvas">
                                                <GeometryDrawing Brush="{DynamicResource canvas}" Geometry="F1M16,16H0V0H16Z" />
                                            </DrawingGroup>
                                            <DrawingGroup x:Name="level_1">
                                                <GeometryDrawing Brush="{DynamicResource light-blue}" Geometry="F1M10.354,14.354l-.708-.708L12.293,11H5.5a4.5,4.5,0,0,1,0-9V3a3.5,3.5,0,0,0,0,7h6.793L9.646,7.354l.708-.708,3.5,3.5v.708Z" />
                                            </DrawingGroup>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Button.Content>
                </Button>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="DefaultTemplate">
            <TextBlock Text="Unknown Type" FontSize="14" FontStyle="Italic"/>
        </DataTemplate>
        <!-- DataTemplateSelector to choose the appropriate template based on the item type -->
        <vm:DroppedListTemplateSelector x:Key="TemplateSelector"
                                              VendorDefnTemplate="{StaticResource DisplayVendorDefn}"
                                              FilamentDefnTemplate="{StaticResource DisplayFilamentDefn}"
                                              FilamentColorTemplate="{StaticResource DisplayFilamentColor}"
                                              DefaultTemplate="{StaticResource DefaultTemplate}"/>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <ListView ItemsSource="{Binding FilesViewSource.View}" ItemTemplateSelector="{StaticResource TemplateSelector}">
            <ListView.Resources>
            </ListView.Resources>

        </ListView>
    </Grid>
</Page>
