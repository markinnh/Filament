<Page x:Class="Filament.WPF6.Pages.FilamentDefnPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Filament.WPF6.Pages"
      xmlns:properties="clr-namespace:Filament.WPF6.Helpers"
      xmlns:vm="clr-namespace:Filament.WPF6.ViewModels"
      xmlns:core="clr-namespace:System;assembly=mscorlib"
      xmlns:model="clr-namespace:DataDefinitions.Models;assembly=DataDefinitions"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" 
      Title="FilamentDefnPage" Name="Main" IsEnabled="{Binding Ready,Mode=OneWay}" >
    <Page.DataContext>
        <vm:FilamentDefnViewModel/>
    </Page.DataContext>
    <Page.Resources>
        <DataTemplate x:Key="LocalDisplayFilamentDefn" DataType="{x:Type model:FilamentDefn}">
            <Grid ToolTip="{Binding MaterialType,Converter={StaticResource EnumDescriptionConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ContentControl
                       Visibility="{Binding IsModified,Converter={StaticResource VisibilityConverter}}"
             
                       VerticalAlignment="Center">
                    <ContentControl.Content>
                        <Rectangle Width="16 " Height="16">
                            <Rectangle.Resources>
                                <SolidColorBrush x:Key="canvas" Opacity="0" />
                                <SolidColorBrush x:Key="light-defaultgrey-10" Color="#212121" Opacity="0.1" />
                                <SolidColorBrush x:Key="light-defaultgrey" Color="#212121" Opacity="1" />
                            </Rectangle.Resources>
                            <Rectangle.Fill>
                                <DrawingBrush Stretch="None">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <DrawingGroup x:Name="canvas">
                                                <GeometryDrawing Brush="{DynamicResource canvas}" Geometry="F1M16,16H0V0H16Z" />
                                            </DrawingGroup>
                                            <DrawingGroup x:Name="level_1">
                                                <GeometryDrawing Brush="{DynamicResource light-defaultgrey-10}" Geometry="F1M13.26,2.736a1.5,1.5,0,0,1,0,2.119l0,0L6.116,12,4,9.884l7.143-7.148A1.5,1.5,0,0,1,13.26,2.736Z" />
                                                <GeometryDrawing Brush="{DynamicResource light-defaultgrey}" Geometry="F1M13.588,5.233A2,2,0,0,0,10.761,2.41v0h0L4.042,9.13,2,13.333,2.667,14l4.065-1.944L13.588,5.24ZM6.224,11.19l-.082.039L4.771,9.858l.039-.082,6.655-6.658a1,1,0,1,1,1.414,1.414h0Z" />
                                            </DrawingGroup>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </ContentControl.Content>
                </ContentControl>

                <StackPanel Grid.Column="1">
                    <StackPanel.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export" Command="{Binding DataContext.ExportFilamentCommand,RelativeSource={RelativeSource AncestorType=Page}}" />
                        </ContextMenu>
                    </StackPanel.ContextMenu>
                    <TextBlock Visibility="{Binding IsDebug,Mode=OneWay,Converter={StaticResource VisibilityConverter}}">
                    <Run Text="Original Material"/>
                    <Run Text="{Binding MaterialType,Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock >
                    <Run Text="Material Type"
                         FontWeight="Bold"/>
                    <Run Text="{Binding Material.ShortName,Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock>
                    <Run Text="Enhancement"/>
                    <Run Text="{Binding Enhancement,Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock >
                    <Run Text="Diameter"
                         FontWeight="Bold"/>
                    <Run Text="{Binding Diameter,Converter={StaticResource ConvertToMetricLength},ConverterParameter='Millimeter',Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock ToolTip="grams per cubic centimeter"
                           >
                    <Run Text="Density"
                         FontWeight="Bold"/>
                    <Run Text="{Binding Density,Mode=OneWay,StringFormat={}{0:#.###}}"/>
                    </TextBlock>
                    <TextBlock ToolTip="milligrams per mm"
                           >
                    <Run Text="mg/mm"
                         FontWeight="Bold"/>
                    <Run Text="{Binding MgPerMM,Mode=OneWay,StringFormat={}{0:#.###}}"/>
                    </TextBlock>
                    <Separator />
                </StackPanel>
            </Grid>
        </DataTemplate>


    </Page.Resources>
    <Grid VerticalAlignment="Top" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding FilamentDefnColumn1,Source={StaticResource LeakPrfSettings},Mode=TwoWay}"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Label Content="Defined Filaments"
               Grid.Row="1"/>
        <ListView
            Grid.Row="2"
            Margin="3"
            VerticalAlignment="Top"
            
            MaxHeight="400"
            ItemsSource="{Binding ViewSource.View}" 
            
            SelectedItem="{Binding SelectedItem}">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Export Selected.." Command="{Binding ExportFilamentCommand}"/>
                </ContextMenu></ListView.ContextMenu>

            
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding MaterialType,Converter={StaticResource EnumDescriptionConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ContentControl
                       Visibility="{Binding IsModified,Converter={StaticResource VisibilityConverter}}"
             
                       VerticalAlignment="Center">
                                <ContentControl.Content>
                                    <Rectangle Width="16 " Height="16">
                                        <Rectangle.Resources>
                                            <SolidColorBrush x:Key="canvas" Opacity="0" />
                                            <SolidColorBrush x:Key="light-defaultgrey-10" Color="#212121" Opacity="0.1" />
                                            <SolidColorBrush x:Key="light-defaultgrey" Color="#212121" Opacity="1" />
                                        </Rectangle.Resources>
                                        <Rectangle.Fill>
                                            <DrawingBrush Stretch="None">
                                                <DrawingBrush.Drawing>
                                                    <DrawingGroup>
                                                        <DrawingGroup x:Name="canvas">
                                                            <GeometryDrawing Brush="{DynamicResource canvas}" Geometry="F1M16,16H0V0H16Z" />
                                                        </DrawingGroup>
                                                        <DrawingGroup x:Name="level_1">
                                                            <GeometryDrawing Brush="{DynamicResource light-defaultgrey-10}" Geometry="F1M13.26,2.736a1.5,1.5,0,0,1,0,2.119l0,0L6.116,12,4,9.884l7.143-7.148A1.5,1.5,0,0,1,13.26,2.736Z" />
                                                            <GeometryDrawing Brush="{DynamicResource light-defaultgrey}" Geometry="F1M13.588,5.233A2,2,0,0,0,10.761,2.41v0h0L4.042,9.13,2,13.333,2.667,14l4.065-1.944L13.588,5.24ZM6.224,11.19l-.082.039L4.771,9.858l.039-.082,6.655-6.658a1,1,0,1,1,1.414,1.414h0Z" />
                                                        </DrawingGroup>
                                                    </DrawingGroup>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </ContentControl.Content>
                            </ContentControl>

                            <StackPanel Grid.Column="1">
                            <!--<Button Content="Export" Command="{Binding DataContext.ExportFilamentCommand,RelativeSource={RelativeSource AncestorType=Page}}" 
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Padding="0"
                                        Margin="0"
                                        Width="50"
                                        Height="16"
                                        FontSize="10"
                                        />-->
                            <TextBlock Visibility="{Binding IsDebug,Mode=OneWay,Converter={StaticResource VisibilityConverter}}">
                    <Run Text="Original Material"/>
                    <Run Text="{Binding MaterialType,Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock >
                    <Run Text="Material Type"
                         FontWeight="Bold"/>
                    <Run Text="{Binding Material.ShortName,Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                    <Run Text="Enhancement"/>
                    <Run Text="{Binding Enhancement,Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock >
                    <Run Text="Diameter"
                         FontWeight="Bold"/>
                    <Run Text="{Binding Diameter,Converter={StaticResource ConvertToMetricLength},ConverterParameter='Millimeter',Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock ToolTip="grams per cubic centimeter"
                           >
                    <Run Text="Density"
                         FontWeight="Bold"/>
                    <Run Text="{Binding Density,Mode=OneWay,StringFormat={}{0:#.###}}"/>
                                </TextBlock>
                                <TextBlock ToolTip="milligrams per mm"
                           >
                    <Run Text="mg/mm"
                         FontWeight="Bold"/>
                    <Run Text="{Binding MgPerMM,Mode=OneWay,StringFormat={}{0:#.###}}"/>
                                </TextBlock>
                                <Separator />
                            </StackPanel>
                        </Grid>

                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="AliceBlue"
                      Grid.RowSpan="10" ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"/>
        <Grid Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl Grid.ColumnSpan="2"
                            ContentTemplate="{StaticResource EditFilamentDefn}"
                            Content="{Binding SelectedItem}"/>
            <!--<Label Content="Filament Type"
               Grid.Row="1"
               />
        <ComboBox Grid.Row="1"
                  Grid.Column="2"
                  Margin="3"
                  Width="250"
                  HorizontalAlignment="Left"
                  ItemsSource="{Binding Source={StaticResource dataFromMaterialType}}"
                  SelectedItem="{Binding SelectedItem.MaterialType}"
                  Background="{StaticResource StandardBackground}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding .,Mode=OneWay}"/>
                        <Run Text="{Binding . ,Converter={StaticResource  EnumDescriptionConverter},Mode=OneTime,StringFormat='({0})'}"/>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Label Content="Diameter"
               Grid.Row="2"
               />
            <Label Content="Density Measurement Type"
               Grid.Row="3"
               />
            <ComboBox 
                Grid.Row="2" 
                Grid.Column="1" 
                Margin="3"
                Width="100"
                HorizontalAlignment="Left"
                ItemsSource="{StaticResource FilamentDiameters}"
                SelectedValue="{Binding SelectedItem.Diameter}"
                Background="{StaticResource StandardBackground}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding }"/>
                    </DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Row="3"
                  Grid.Column="1"
                  Margin="3"
                  Width="150"
                  HorizontalAlignment="Left"
                  ItemsSource="{Binding Source={StaticResource dataFromDensityEditType}}"
                  SelectedItem="{Binding DensityType,Mode=TwoWay}"
                  />
        <GroupBox Header="Defined Density"
            Grid.Row="4"
            
            Grid.ColumnSpan="2"
            Visibility="{Binding DefinedDensityShown,Converter={StaticResource VisibilityConverter}}"
                  Margin="5" Height="75">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="Density"
                       />
                <TextBox Grid.Column="1"
                         Text="{Binding SelectedItem.DensityAlias.DefinedDensity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                         />
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="5"
                  
                  Grid.ColumnSpan="2"
                  
                  ItemsSource="{Binding SelectedItem.DensityAlias.MeasuredDensity}"
                  Visibility="{Binding MeasuredDensityShown,Converter={StaticResource VisibilityConverter}}" AutoGenerateColumns="False"
                  
                  >
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Diameter,UpdateSourceTrigger=PropertyChanged}" ClipboardContentBinding="{x:Null}" Header="Diameter" Width="100"/>
                <DataGridTextColumn Binding="{Binding Length,UpdateSourceTrigger=PropertyChanged}" ClipboardContentBinding="{x:Null}" Header="Length" Width="100"/>
                <DataGridTextColumn Binding="{Binding Weight,UpdateSourceTrigger=LostFocus}" ClipboardContentBinding="{x:Null}" Header="Weight" Width="100"/>
                <DataGridTextColumn Binding="{Binding DensityInGmPerCC}" ClipboardContentBinding="{x:Null}" Header="Density" IsReadOnly="True" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Header="Average Density"
                  Grid.Row="4"
                  Grid.ColumnSpan="2"
                  Visibility="{Binding MeasuredDensityShown,Converter={StaticResource VisibilityConverter}}"
                  Margin="5" Height="75">
            <StackPanel>
                <TextBlock>
                    <Run Text="Average Measured Density : "/>
                    <Run Text="{Binding SelectedItem.DensityAlias.Density, Mode=OneWay,StringFormat={}{0:#.#####}}"/>
                </TextBlock>
            </StackPanel>
            </GroupBox>-->
            <StackPanel 
                Orientation="Horizontal"
                Grid.Row="1"
                Grid.ColumnSpan="2">
                <Button Style="{StaticResource RoundedCommandButton}"
                        Content="{StaticResource SaveAll}"
                        IsEnabled="{Binding HasModifiedItems}"
                        Command="{Binding SaveAllChangesCommand}"/>
                <Button
                    
                    Content="{StaticResource SaveIcon}"
                    Style="{StaticResource RoundedCommandButton}"
                    Command="{Binding UpdateCommand}"
                    IsEnabled="{Binding SelectedItem.IsModified,Mode=OneWay}"/>
                <Button 
                    Style="{StaticResource RoundedCommandButton}"
                    Content="{StaticResource AddIcon}"
                    Command="{Binding NewItemCommand}"
                    IsEnabled="{Binding CanAdd}"/>
                <Button 
        Style="{StaticResource RoundedCommandButton}"
        Command="{Binding DeleteSelectedCommand}"
        Content="{StaticResource DeleteIcon}"
        IsEnabled="{Binding CanDelete,Mode=OneWay}"
        Visibility="{Binding SelectedItem.SupportsDelete,Converter={StaticResource VisibilityConverter}}">

                    <Button.ToolTip>
                        <TextBlock>
            <Run Text="Delete"/>
            <Run Text="{Binding ChildTypeName,Mode=OneWay}"/>
                        </TextBlock>
                    </Button.ToolTip>
                </Button>

                <!--<Button Style="{StaticResource CommandButton}"
                        Content="Prepopulate"
                        Command="{Binding Prepopulate}"
                        Visibility="{Binding IsDebug,Converter={StaticResource VisibilityConverter}}"/>-->
            </StackPanel>
        </Grid>
    </Grid>
</Page>
