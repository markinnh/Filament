<Page x:Class="Filament.WPF6.Pages.Materials"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Filament.WPF6.Pages"
      xmlns:model="clr-namespace:DataDefinitions.Models;assembly=DataDefinitions"
      xmlns:vm="clr-namespace:Filament.WPF6.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Materials">
    <Page.Resources>
        <DataTemplate x:Key="DisplayMaterial" DataType="model:Material">
            <StackPanel>
                <TextBlock Text="{Binding Name}"/>
                <TextBlock Text="{Binding ShortName}"/>
                <TextBlock Text="{Binding Enhancements.Count,Mode=OneWay}"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Page.DataContext>
        <vm:MaterialsViewModel/>
    </Page.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView Grid.Row="1" Height="400" ItemsSource="{Binding ViewSource.View}" SelectedItem="{Binding SelectedItem,Mode=TwoWay}" ItemTemplate="{StaticResource DisplayMaterial}"/>
        <Grid Grid.Column="1" Grid.RowSpan="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentControl ContentTemplate="{StaticResource MaterialEditor}" Content="{Binding SelectedItem,Mode=TwoWay}"/>
            <StackPanel 
    Orientation="Horizontal"
    Grid.Row="1"
    Grid.ColumnSpan="2">
                <Button Style="{StaticResource RoundedCommandButton}"
    Content="{StaticResource SaveAll}"
    IsEnabled="{Binding HasModifiedItems}"
    Command="{Binding SaveAllChangesCommand}"/>
                <Button
        
        Content="{StaticResource SaveIcon}"
        Style="{StaticResource RoundedCommandButton}"
        Command="{Binding UpdateCommand}"
        IsEnabled="{Binding SelectedItem.IsModified,Mode=OneWay}"/>
                <Button 
        Style="{StaticResource RoundedCommandButton}"
        Content="{StaticResource AddIcon}"
        Command="{Binding NewItemCommand}"
        IsEnabled="{Binding CanAdd}"/>
                
            </StackPanel>
        </Grid>
    </Grid>
</Page>
