<Page x:Class="Filament.WPF6.Pages.FilamentColors"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Filament.WPF6.Pages"
      xmlns:vm="clr-namespace:Filament.WPF6.ViewModels"
      xmlns:models="clr-namespace:DataDefinitions.Models;assembly=DataDefinitions"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FilamentColors">
    <Page.DataContext>
        <vm:FilamentColorsViewModel/>
    </Page.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Color Definitions"/>
        <ToggleButton Grid.Row="1" x:Name="SortDirection" 
                        HorizontalAlignment="Right"
                        Content="{StaticResource SortAscendingIcon}"
                        Command="{Binding DoSwitchSortDirectionCommand}" 
                        CommandParameter="{Binding ElementName=SortDirection,Path=IsChecked}"
                        IsChecked="{Binding SortAscending,Mode=OneWay}"
                        />
        <ListView Grid.Row="2" Height="400" ItemsSource="{Binding ViewSource.View}" SelectedItem="{Binding SelectedItem}" >
            <ListView.ItemTemplate>
                <DataTemplate DataType="models:FilamentColor">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Fill="{Binding ColorRGB}" Height="20" Width="20"/>
                        <TextBlock Text="{Binding VendorColorName}"/>
                    </StackPanel>
                </DataTemplate></ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Column="1" Grid.RowSpan="3">
            <ContentControl Grid.Column="1" Content="{Binding SelectedItem}" ContentTemplate="{StaticResource FilamentColorEditor}"/>
            <StackPanel 
                Orientation="Horizontal"
                Grid.Row="1"
                Grid.ColumnSpan="2">
                <Button Style="{StaticResource RoundedCommandButton}"
                Content="{StaticResource SaveAll}"
                IsEnabled="{Binding HasModifiedItems}"
                Command="{Binding SaveAllChangesCommand}"/>
                <Button
        
                    Content="{StaticResource SaveIcon}"
                    Style="{StaticResource RoundedCommandButton}"
                    Command="{Binding UpdateCommand}"
                    IsEnabled="{Binding SelectedItem.IsModified,Mode=OneWay}"/>
                <Button 
                    Style="{StaticResource RoundedCommandButton}"
                    Content="{StaticResource AddIcon}"
                    Command="{Binding NewItemCommand}"
                    IsEnabled="{Binding CanAdd}"/>
                <TextBox x:Name="LookupRGB" Text="#" Width="75" Height="28" ToolTip="Lookup RGB value" CharacterCasing="Upper"/>
                <Button Style="{StaticResource RoundedCommandButton}"
                        Content="{StaticResource LookupListItem}"
                        Command="{Binding DoLookupCommand}" 
                        CommandParameter="{Binding ElementName=LookupRGB,Path=Text}"/>
            </StackPanel>
        </Grid>



    </Grid>
</Page>
