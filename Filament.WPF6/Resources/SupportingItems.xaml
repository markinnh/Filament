                    <CheckBox.Content>
                        <TextBlock Text="{x:Static rsrc:Resources.DisplayFoundOnAmazonHeader}"/>
                    </CheckBox.Content>
                </CheckBox>
                <Separator/>

            </StackPanel>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DisplayFilaDefnInList" DataType="{x:Type model:FilamentDefn}">
