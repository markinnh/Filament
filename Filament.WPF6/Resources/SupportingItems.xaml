    <ControlTemplate x:Key="validationTemplate">
        <DockPanel>
            <TextBlock Foreground="Red" FontSize="20">!</TextBlock>
            <AdornedElementPlaceholder/>
        </DockPanel>
    </ControlTemplate>
    <Style x:Key="textBoxInError" TargetType="{x:Type TextBox}">
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="true">
                <Setter Property="ToolTip"
              Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                              Path=(Validation.Errors)[0].ErrorContent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="FilamentColorEditor" DataType="model:FilamentColor">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Content="Vendor Color Name"/>
            <TextBox Grid.Column="1" HorizontalAlignment="Left" Width="180" Text="{Binding VendorColorName,Mode=TwoWay}"/>
            <!--<Label Grid.Row="1" Content="Color (RGB)"/>
            <synf:ColorPicker Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" Width="150" Color="{Binding ColorRGB,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />-->
            <Label Grid.Row="2" Content="Color (Hex)"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox HorizontalAlignment="Left" Width="150" MaxLength="9" Validation.ErrorTemplate="{StaticResource validationTemplate}">
                    <TextBox.Text>
                        <Binding Path="ColorRGB" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <helpers:RegexValidationRule Pattern="^#FF([a-fA-F0-9]){6}$" ValidatesOnTargetUpdated="True" />
                            </Binding.ValidationRules>
                        </Binding>

                    </TextBox.Text>
                    <TextBox.ToolTip>
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Width="300">
                            <Run Text="Enter a color in the format #FFRRGGBB, where RR, GG, and BB are hexadecimal values for red, green, and blue components respectively."/>
                            <Run Text="The #FF (transparency) is required to be there for validation and when rendering the color to the display." FontWeight="Bold"/>
                            <Run Text="The colors that are pre-existing are found on various sites, which use the RRGGBB format" FontStyle="Italic"/></TextBlock>
                        </StackPanel>
                    </TextBox.ToolTip>
                </TextBox>
                <Border Width="20" Height="20" Margin="5,0,0,0" Background="{Binding ColorRGB,Mode=OneWay}" BorderBrush="Black" BorderThickness="1" CornerRadius="3"/>
            </StackPanel>
            <Label Grid.Row="3" Content="Tag"/>
            <TextBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Width="150" Text="{Binding Tags,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MaterialEditor" DataType="model:Material">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Material Definition"/>
            <Label Content="Material _Name" Grid.Row="1" Target="{Binding ElementName=NameTextBox}"/>
            <TextBox x:Name="NameTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="250" HorizontalAlignment="Left"/>
            <Label Content="_Short Name" Grid.Row="2" Target="{Binding ElementName=ShrtNameTextBox}" />
            <TextBox x:Name="ShrtNameTextBox" Grid.Row="2" Grid.Column="1"  MaxLength="10" Text="{Binding ShortName,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="150" HorizontalAlignment="Left"/>
            <Label Content="_Enhancements" Grid.Row="3"/>
            <DataGrid Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Enhancements}" AutoGenerateColumns="False" Width="350" Height="200" CanUserAddRows="True" HorizontalAlignment="Left">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name,Mode=TwoWay}" Width="100"/>
                    <DataGridCheckBoxColumn Header="MMS" Binding="{Binding MMSCompatible,Mode=TwoWay}" Width="100">
                        <DataGridCheckBoxColumn.HeaderStyle>
                            <Style>
                                <Setter Property="ToolTipService.ToolTip" Value="Multimaterial system compatible"/>
                            </Style>
                        </DataGridCheckBoxColumn.HeaderStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridCheckBoxColumn Header="Abrasive" Binding="{Binding Abrasive,Mode=TwoWay}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="NoEditorTemplate">
        <TextBlock Text="No Editor Defined"
                   FontSize="24"/>
    </DataTemplate>

